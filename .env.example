# Copy to .env before running the stack:  cp .env.example .env

# Airflow runs containers as this UID so files written into the mounted ./data
# and ./logs directories are owned by you, not root. 50000 is the image default
# and works on macOS; on Linux use your own:  echo "AIRFLOW_UID=$(id -u)"
AIRFLOW_UID=50000

# Airflow web UI credentials (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Experiment tracking ----------------------------------------------------
# Local compose MLflow (default for Airflow-in-Docker without Databricks):
#   MLFLOW_TRACKING_URI=http://mlflow:5000
#   MLFLOW_EXPERIMENT=ampops-demand-forecasting
#
# Databricks (local `make train` or Airflow when compose reads these vars):
#   MLFLOW_TRACKING_URI=databricks
#   MLFLOW_EXPERIMENT=/Users/you@uchicago.edu/Ampops
#   DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
#   DATABRICKS_TOKEN=<pat>
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT=/Users/you@uchicago.edu/Ampops
# Workspace Model Registry is often disabled; Unity Catalog is the default.
# Use a 3-level name, or leave AMPOPS_MODEL_NAME short and set AMPOPS_UC_MODEL_PREFIX.
MLFLOW_REGISTRY_URI=databricks-uc
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
AMPOPS_MODEL_NAME=ampops_demand_forecaster
AMPOPS_UC_MODEL_PREFIX=main.default

# Data root. Set inside containers by docker-compose; leave unset locally and
# ampops.config falls back to <repo>/data.
# AMPOPS_DATA_DIR=/opt/airflow/data
