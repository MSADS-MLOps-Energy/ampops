# Copy to .env before running the stack:  cp .env.example .env

# Airflow runs containers as this UID so files written into the mounted ./data
# and ./logs directories are owned by you, not root. 50000 is the image default
# and works on macOS; on Linux use your own:  echo "AIRFLOW_UID=$(id -u)"
AIRFLOW_UID=50000

# Airflow web UI credentials (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# MLflow tracking server. Inside the compose network it is http://mlflow:5000
# (what Airflow uses, below). From your browser it is http://localhost:5050 —
# host port 5050, because macOS AirPlay Receiver already occupies 5000.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=ampops-demand-forecasting
AMPOPS_MODEL_NAME=ampops-demand-forecaster

# Data root. Set inside containers by docker-compose; leave unset locally and
# ampops.config falls back to <repo>/data.
# AMPOPS_DATA_DIR=/opt/airflow/data
