# Copy to .env before running the stack:  cp .env.example .env

# UID the Airflow containers run as. Leave this at 50000 on every platform:
# it is the image default, and the Dockerfile chowns /opt/airflow/data to it so
# the data/logs named volumes come up writable. See make data-export.
AIRFLOW_UID=50000

# Airflow web UI credentials (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Experiment tracking (Databricks MLflow) ---------------------------------
# H2O AutoML still trains in-process (host or Airflow). Databricks is only the
# MLflow tracking / registry backend — not Databricks AutoML.
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT=/Users/you@uchicago.edu/Ampops
MLFLOW_REGISTRY_URI=databricks-uc
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
AMPOPS_MODEL_NAME=ampops-demand-forecaster
# If registry soft-fails for missing UC path, set a real catalog.schema prefix:
# AMPOPS_UC_MODEL_PREFIX=main.default

# Optional: use compose-local MLflow instead of Databricks
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_EXPERIMENT=ampops-demand-forecasting

# Data root. Set inside containers by docker-compose; leave unset locally and
# ampops.config falls back to <repo>/data.
# AMPOPS_DATA_DIR=/opt/airflow/data
