# Copy to .env before running the stack:  cp .env.example .env

# UID the Airflow containers run as. Leave this at 50000 on every platform:
# it is the image default, and the Dockerfile chowns /opt/airflow/data to it so
# the data/logs named volumes come up writable. See make data-export.
AIRFLOW_UID=50000

# Airflow web UI credentials (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Experiment tracking -------------------------------------------------------
# Exactly ONE of the two blocks below may have uncommented KEY=VALUE lines --
# dotenv/docker-compose parsing is last-key-wins, so if both are uncommented at
# once the later block silently wins with no error. H2O AutoML always trains
# in-process (host or Airflow) either way; Databricks is only the MLflow
# tracking/registry backend, not Databricks AutoML.
AMPOPS_MODEL_NAME=ampops-demand-forecaster

# ACTIVE: Databricks MLflow (Unity Catalog registry).
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT=/Users/you@uchicago.edu/Ampops
MLFLOW_REGISTRY_URI=databricks-uc
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
# catalog.schema for Unity Catalog registration -- must already exist in your
# workspace. workspace.default is auto-created in every workspace, so it's a
# safe default; swap it for your own catalog.schema if you have one.
AMPOPS_UC_MODEL_PREFIX=workspace.default

# FALLBACK (commented out): compose-local MLflow. To activate: comment out the
# Databricks block above (keep AMPOPS_MODEL_NAME), then uncomment below.
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_REGISTRY_URI=http://mlflow:5000
# MLFLOW_EXPERIMENT=ampops-demand-forecasting

# Data root. Set inside containers by docker-compose; leave unset locally and
# ampops.config falls back to <repo>/data.
# AMPOPS_DATA_DIR=/opt/airflow/data

# --- Serving layer (docs/serving_contract.md §9) ------------------------------
# Feature store + forecast cache. Seed it with `make seed-redis` before the
# first request, or every /predict returns 422 for lack of history.
REDIS_URL=redis://redis:6379/0
# redis | parquet. "redis" is the compose/production pair; "parquet" is the
# Redis-free pair used by the tests and by `make run-api` on the host.
AMPOPS_STORE_BACKEND=redis
# Source for the parquet backend only. Ignored when AMPOPS_STORE_BACKEND=redis.
# AMPOPS_PARQUET_PATH=data/processed/joined_hourly.parquet
# Explicit model URI override. Unset, the API loads
# models:/${AMPOPS_MODEL_NAME}@champion — which legitimately may not resolve if
# registration soft-failed, in which case /ready reports 503 and /health stays
# green. Point this at a runs:/<run_id>/model URI to serve an unregistered run.
# AMPOPS_SERVING_MODEL_URI=
AMPOPS_GRID_ID=COMED
# Where dags/ampops_daily_forecast.py sends POST /predict/batch.
AMPOPS_API_URL=http://api:8000
# Replay mode: the dataset ends 2018-08-02, so the forecast DAG simulates
# "today" and forecasts the following 24 hours from seeded observations. This
# is a rehearsal of the operational loop, not live forecasting.
AMPOPS_SIMULATED_TODAY=2018-08-01
# The forecast DAG's Postgres connection. Airflow picks up AIRFLOW_CONN_* env
# vars automatically, so no manual UI setup is needed.
AIRFLOW_CONN_AMPOPS_DB=postgresql://airflow:airflow@postgres/ampops
