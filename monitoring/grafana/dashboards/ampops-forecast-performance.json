          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    f.target_ts AS \"time\",\n    a.actual_mw AS \"Actual MW\",\n    f.predicted_mw AS \"Predicted MW\"\nFROM forecasts f\nJOIN actuals a\n    ON f.grid_id = a.grid_id\n   AND f.target_ts = a.target_ts\nWHERE f.grid_id = 'COMED'\n  AND $__timeFilter(f.target_ts)\nORDER BY f.target_ts;",
          "refId": "A",
          "sql": {
