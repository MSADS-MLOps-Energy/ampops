          "rawSql": "SELECT\n    100.0 * AVG(\n        ABS(a.actual_mw - f.predicted_mw)\n        / NULLIF(ABS(a.actual_mw), 0)\n    ) AS \"MAPE\"\nFROM forecasts f\nJOIN actuals a\n    ON f.grid_id = a.grid_id\n   AND f.target_ts = a.target_ts\nWHERE f.grid_id = 'COMED'\n  AND $__timeFilter(f.target_ts);\n",
